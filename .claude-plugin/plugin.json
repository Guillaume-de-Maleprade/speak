{
  "name": "speak",
  "version": "0.3.1",
  "description": "Lets the agent speak out loud, offline, with Kyutai Pocket TTS (Windows, CPU).",
  "author": { "name": "Guillaume de Maleprade" },
  "repository": "https://github.com/Guillaume-de-Maleprade/speak",
  "license": "MIT",
  "mcpServers": {
    "speak": {
      "command": "python",
      "args": ["-m", "speak_mcp.server"],
      "env": { "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src" }
    }
  }
}
